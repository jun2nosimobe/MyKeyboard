                        <TextView android:id="@+id/flick_ma" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:text="ま" android:gravity="center" android:clickable="true" android:background="?android:attr/selectableItemBackground" android:textSize="20sp" android:textColor="#000000" />
