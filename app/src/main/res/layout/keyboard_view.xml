                <TextView android:id="@+id/btn_paren_l" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:text="(" android:gravity="center" android:clickable="true" android:background="?android:attr/selectableItemBackground" android:textSize="18sp" android:textColor="#000000" />
